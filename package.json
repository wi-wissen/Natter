{
  "name": "natter-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "node scripts/size.mjs",
    "web:build": "node packages/web/build.mjs",
    "web:e2e": "node packages/web/e2e/run.mjs && node packages/web/e2e/forms.mjs && node packages/web/e2e/pgzero.mjs",
    "assets:catalog": "node scripts/build-asset-catalog.mjs",
    "reference": "node scripts/build-reference.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "vitest": "^2.1.9"
  }
}
