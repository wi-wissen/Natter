{
  "name": "@natterjs/assets",
  "version": "0.1.1",
  "description": "Image and sound library for Natter (Pygame Zero, kara, turtle): about 920 PNG sprites in a flat emoji style, two SVG turtles, 14 sounds and a catalog",
  "license": "(CC0-1.0 AND MIT)",
  "author": "Natter contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wi-wissen/Natter.git",
    "directory": "packages/assets"
  },
  "homepage": "https://natter.wi7.net/",
  "bugs": "https://github.com/wi-wissen/Natter/issues",
  "keywords": [
    "natter",
    "pygame-zero",
    "sprites",
    "game-assets",
    "cc0",
    "education",
    "kara",
    "turtle"
  ],
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": {
      "import": "./index.js",
      "default": "./index.js"
    },
    "./catalog.json": "./catalog.json",
    "./gametypes.json": "./gametypes.json",
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": [
    "index.js",
    "catalog.json",
    "gametypes.json",
    "*/pack.json",
    "*/*.png",
    "*/*.svg",
    "sounds/sounds.json",
    "sounds/*.wav",
    "README.md",
    "LICENSE-ASSETS.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "prepack": "node ../../scripts/copy-license.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
